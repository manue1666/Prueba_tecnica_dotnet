@model IEnumerable<PruebaTecnica.Models.Post>

@{
    ViewData["Title"] = "Posts";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="bi bi-file-post"></i> Posts List
        </h1>
        <a asp-controller="Post" asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> Create New Post
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="alert alert-info mb-4" role="alert">
        <strong>Note:</strong> This application uses <strong>JSONPlaceholder</strong>, a fake API for testing. 
        Create, Edit, and Delete operations simulate success but data is <strong>not actually persisted</strong>. 
        This is designed for learning purposes only.
    </div>

    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-lg-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0 hover-shadow" style="transition: transform 0.2s; cursor: pointer;">
                    <div class="card-header bg-light border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">Post #@post.Id</span>
                            <span class="badge bg-secondary">User @post.UserId</span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body">
                        <h5 class="card-title">@post.Title</h5>
                        <p class="card-text text-muted">@post.Body</p>
                    </div>

                    <div class="card-footer bg-light border-top">
                        <div class="d-grid gap-2 d-sm-flex">
                            <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="btn btn-sm btn-info flex-grow-1">
                                <i class="bi bi-eye"></i> Details
                            </a>
                            <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-sm btn-warning flex-grow-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" class="btn btn-sm btn-danger flex-grow-1">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        transform: translateY(-5px);
    }

    .card-title {
        font-weight: 600;
        color: #2c3e50;
    }

    .card-text {
        font-size: 0.95rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>