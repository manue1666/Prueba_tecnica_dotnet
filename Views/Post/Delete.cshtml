@model PruebaTecnica.Models.Post

@{
    ViewData["Title"] = "Delete Post";
}

<h1>Delete Post</h1>

<!-- Aviso de JSONPlaceholder -->
<div class="alert alert-warning" role="alert">
    <strong>Reminder:</strong> This deletion will <strong>NOT be persisted</strong> on the server. 
    This uses JSONPlaceholder, a fake API for testing purposes.
</div>

<h3>Are you sure you want to delete this post?</h3>

<div>
    <h4>Post</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            UserId
        </dt>
        <dd class="col-sm-10">
            @Model.UserId
        </dd>
        <dt class="col-sm-2">
            Id
        </dt>
        <dd class="col-sm-10">
            @Model.Id
        </dd>
        <dt class="col-sm-2">
            Title
        </dt>
        <dd class="col-sm-10">
            @Model.Title
        </dd>
        <dt class="col-sm-2">
            Body
        </dt>
        <dd class="col-sm-10">
            @Model.Body
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
